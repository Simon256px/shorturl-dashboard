[Unit]
Description=shorturl-dashboard — URL shortener with analytics
Documentation=https://github.com/Simon256px/shorturl-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/shorturl
EnvironmentFile=/etc/shorturl/shorturl.env
WorkingDirectory=/var/lib/shorturl

Restart=on-failure
RestartSec=3s
# Give SQLite time to flush the pending click batch on stop.
TimeoutStopSec=20s
KillSignal=SIGTERM

# --- Identity -----------------------------------------------------------------
# DynamicUser allocates a throwaway UID at start and gives us /var/lib/shorturl
# with the right ownership, so there is no system account to create or forget
# about. StateDirectory data survives restarts and UID changes.
DynamicUser=yes
StateDirectory=shorturl
StateDirectoryMode=0700
UMask=0077

# --- Filesystem ---------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/shorturl

# --- Kernel & privileges ------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Only IP sockets — no unix, netlink, packet or bluetooth sockets needed.
RestrictAddressFamilies=AF_INET AF_INET6

# NOTE: MemoryDenyWriteExecute is deliberately NOT set. V8 needs W+X pages for
# its JIT; enabling it makes the process die on startup.

# --- Resources ----------------------------------------------------------------
# A single SQLite-backed process. These caps turn a runaway into a restart
# rather than an OOM that takes the host down with it.
MemoryMax=512M
TasksMax=128
LimitNOFILE=8192

# --- Logging ------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shorturl

[Install]
WantedBy=multi-user.target
