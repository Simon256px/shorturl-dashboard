# Caddy handles TLS certificates automatically (Let's Encrypt / ZeroSSL).
# Replace s.example.com with your domain, then:
#
#   sudo dnf install caddy
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl enable --now caddy
#
# Remember to set TRUST_PROXY=true in shorturl.env so the app reads the
# forwarded client IP instead of 127.0.0.1 — otherwise every visitor is
# counted as the same person and rate limiting throttles everyone at once.

s.example.com {
	encode zstd gzip

	# The app is not reachable from outside; only Caddy talks to it.
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {remote_host}
	}

	# Caddy sets X-Forwarded-For and X-Forwarded-Proto by default.

	log {
		output file /var/log/caddy/shorturl.log {
			roll_size 20mb
			roll_keep 5
		}
		# Redirect traffic is high volume and the app already keeps its own
		# (privacy-preserving) analytics. Drop this block for full access logs.
		format json
	}
}
