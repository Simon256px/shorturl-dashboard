# ---------------------------------------------------------------------------
# shorturl-dashboard — copy to .env and edit.  chmod 600 .env on the server.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# Bind address. Keep 127.0.0.1 when a reverse proxy (Caddy/nginx) sits in front.
HOST=127.0.0.1
PORT=8000

# Public origin of the shortener. Used to build short links, QR codes and to
# validate the Origin header on state-changing requests (CSRF defence).
BASE_URL=http://localhost:8000

# Set to true ONLY when a trusted reverse proxy sets X-Forwarded-For.
# If this is true and nothing is proxying you, clients can spoof their IP.
TRUST_PROXY=false

# --- Storage ---------------------------------------------------------------
DATA_DIR=./data

# --- Admin authentication --------------------------------------------------
# Generate with:  deno task hash-password
# Preferred over ADMIN_PASSWORD: the plaintext never touches disk.
ADMIN_PASSWORD_HASH=

# Convenience fallback — hashed in memory at boot. Fine for a first run,
# switch to ADMIN_PASSWORD_HASH afterwards.
ADMIN_PASSWORD=

# How long a dashboard session stays valid.
SESSION_TTL_HOURS=168

# --- Behaviour -------------------------------------------------------------
# Allow unauthenticated visitors to create short links on the public form.
PUBLIC_SHORTENING=false

# Allow shortening to private/loopback/link-local addresses.
# Keep false: it stops your shortener being used to CSRF people's routers.
ALLOW_PRIVATE_TARGETS=false

# 302 keeps analytics accurate (browsers cache 301 forever and stop calling you).
REDIRECT_STATUS=302

# Click rows older than this are purged nightly. 0 disables purging.
ANALYTICS_RETENTION_DAYS=400

# --- Discord ---------------------------------------------------------------
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Leave empty to disable the Discord reporter entirely.
DISCORD_WEBHOOK_URL=

# Seconds between edits of the stats message. Minimum 60. Discord rate-limits
# webhook edits, so 3600 (1 houre) is a comfortable default.
DISCORD_UPDATE_INTERVAL_SECONDS=3600
