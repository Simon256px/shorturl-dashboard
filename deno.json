{
  "name": "shorturl-dashboard",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "license": "MIT",

  "nodeModulesDir": "none",

  "imports": {
    "hono": "jsr:@hono/hono@^4.13.0",
    "hono/html": "jsr:@hono/hono@^4.13.0/html",
    "hono/cookie": "jsr:@hono/hono@^4.13.0/cookie",
    "hono/logger": "jsr:@hono/hono@^4.13.0/logger",
    "qrcode-generator": "npm:qrcode-generator@^1.5.2",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },

  "tasks": {
    "dev": "deno run --watch --env-file=.env --allow-net --allow-write=./data --allow-read=./data --allow-env src/main.ts",
    "start": "deno run --env-file=.env --allow-net --allow-write=./data --allow-read=./data --allow-env src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net",
    "check": "deno check src/main.ts && deno lint && deno fmt --check",
    "fmt": "deno fmt",
    "hash-password": "deno run --allow-env scripts/hash-password.ts",
    "compile": "deno compile --allow-net --allow-write=./data --allow-read=./data --allow-env --output dist/shorturl src/main.ts"
  },

  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },

  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },

  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },

  "exclude": ["data/", "dist/", "probe.ts", "probe2.ts"]
}
